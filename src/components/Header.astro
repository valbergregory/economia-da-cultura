---
import Icon from './Icon.astro';
import { NAV, site, type NavKey } from '@/data/site';
import { url } from '@/lib/content';

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')} title={site.name}>
      <span class="brand-mark" aria-hidden="true">
        <Icon name="music" size={18} />
      </span>
      <span class="brand-text">
        <span class="brand-name">{site.shortName}</span>
        <span class="brand-sub">e Entretenimento · {site.authorShort}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <Icon name="menu" class="icon-menu" size={22} />
      <Icon name="close" class="icon-close" size={22} />
      <span class="visually-hidden" data-label-open="Abrir menu" data-label-close="Fechar menu">
        Abrir menu
      </span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Navegação principal" data-nav>
      <ul class="nav-list">
        {NAV.map((item) => (
          <li>
            <a
              class:list={['nav-link', { active: item.key === current }]}
              href={url(item.path)}
              aria-current={item.key === current ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-tools">
        <a class="tool" href={site.links.academic} title="Site acadêmico" rel="me">
          <Icon name="external" size={18} />
          <span class="tool-label">Site acadêmico</span>
        </a>
        <button class="tool theme-toggle" type="button" data-theme-toggle title="Alternar tema">
          <Icon name="sun" class="icon-sun" size={18} />
          <Icon name="moon" class="icon-moon" size={18} />
          <span class="visually-hidden">Alternar tema claro/escuro</span>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
    position: relative;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text);
    min-height: 2.75rem;
    white-space: nowrap;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--wine);
    color: var(--text-inverse);
    flex: none;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    font-variation-settings:
      'opsz' 24,
      'SOFT' 50;
  }
  .brand-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .nav-list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg-muted);
  }
  .nav-link.active {
    color: var(--wine);
    background: var(--wine-soft);
  }
  .nav-tools {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
  }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    text-decoration: none;
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }
  .tool:hover {
    color: var(--text);
    background: var(--bg-muted);
  }
  .tool-label {
    display: none;
  }
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    cursor: pointer;
  }
  .nav-toggle :global(.icon-close),
  .nav-toggle[aria-expanded='true'] :global(.icon-menu) {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }
  .theme-toggle :global(.icon-moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-moon) {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-sun) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-moon) {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-sun) {
      display: none;
    }
  }
  @media (max-width: 64rem) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-5) var(--space-5);
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      text-align: center;
    }
    .site-nav.open {
      display: flex;
    }
    .nav-list {
      flex-direction: column;
      gap: 0;
    }
    .nav-link {
      width: 100%;
      justify-content: center;
      min-height: 3rem;
    }
    .nav-tools {
      border-left: 0;
      padding-left: 0;
      padding-top: var(--space-3);
      border-top: 1px solid var(--border);
      justify-content: center;
    }
    .tool-label {
      display: inline;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const label = toggle?.querySelector<HTMLElement>('.visually-hidden');
  function setOpen(open: boolean) {
    if (!toggle || !nav || !label) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
    label.textContent = open ? label.dataset.labelClose! : label.dataset.labelOpen!;
  }
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (
      nav?.classList.contains('open') &&
      !nav.contains(e.target as Node) &&
      e.target !== toggle &&
      !toggle?.contains(e.target as Node)
    )
      setOpen(false);
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const explicit = root.getAttribute('data-theme');
    const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = explicit ? explicit === 'dark' : systemDark;
    const next = isDark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* sem armazenamento */
    }
  });
</script>
