---
import Icon from './Icon.astro';
import { NAV, site, type NavKey } from '@/data/site';
import { url } from '@/lib/content';

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')} title={site.longName}>
      <span class="brand-name">Economia &amp; Cultura</span>
      <span class="brand-sub">por {site.authorShort}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <Icon name="menu" class="icon-menu" size={22} />
      <Icon name="close" class="icon-close" size={22} />
      <span class="visually-hidden" data-label-open="Abrir menu" data-label-close="Fechar menu">
        Abrir menu
      </span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Navegação principal" data-nav>
      <ul class="nav-list">
        {NAV.map((item) => (
          <li>
            <a
              class:list={['nav-link', { active: item.key === current }]}
              href={url(item.path)}
              aria-current={item.key === current ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <button class="theme-toggle" type="button" data-theme-toggle title="Alternar tema">
        <Icon name="sun" class="icon-sun" size={18} />
        <Icon name="moon" class="icon-moon" size={18} />
        <span class="visually-hidden">Alternar tema claro/escuro</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule-strong);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
    position: relative;
  }
  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
    color: var(--ink);
    min-height: 2.75rem;
    justify-content: center;
    white-space: nowrap;
    text-align: left;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-sub {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: 0.35rem;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .nav-list {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--text-base);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover {
    color: var(--terracotta-deep);
  }
  .nav-link.active {
    color: var(--terracotta-deep);
    border-bottom-color: var(--terracotta);
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .nav-toggle :global(.icon-close),
  .nav-toggle[aria-expanded='true'] :global(.icon-menu) {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }
  .theme-toggle :global(.icon-moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-moon) {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-sun) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-moon) {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-sun) {
      display: none;
    }
  }
  @media (max-width: 64rem) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-5) var(--space-5);
      background: var(--paper);
      border-bottom: 1px solid var(--rule-strong);
      box-shadow: var(--shadow-paper);
      text-align: center;
    }
    .site-nav.open {
      display: flex;
    }
    .nav-list {
      flex-direction: column;
      gap: 0;
    }
    .nav-link {
      width: 100%;
      justify-content: center;
      min-height: 3rem;
      border-bottom: 1px solid var(--rule);
    }
    .nav-link.active {
      border-bottom-color: var(--terracotta);
    }
    .theme-toggle {
      margin-inline: auto;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const label = toggle?.querySelector<HTMLElement>('.visually-hidden');
  function setOpen(open: boolean) {
    if (!toggle || !nav || !label) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
    label.textContent = open ? label.dataset.labelClose! : label.dataset.labelOpen!;
  }
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (nav?.classList.contains('open') && !nav.contains(t) && !toggle?.contains(t)) setOpen(false);
  });

  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const explicit = root.getAttribute('data-theme');
    const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
    const isDark = explicit ? explicit === 'dark' : systemDark;
    const next = isDark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* sem armazenamento */
    }
  });
</script>
