---
/** Galeria de fotos a partir de src/data/fotos.ts e src/assets/fotos/ (centralizada). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fotos } from '@/data/fotos';

interface Props {
  /** Limita o número de fotos. */
  limit?: number;
}
const { limit } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/fotos/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const items = fotos
  .map((f) => ({ ...f, image: files[`/src/assets/fotos/${f.file}`]?.default }))
  .filter((f) => {
    if (!f.image) console.warn(`[fotos] arquivo não encontrado: ${f.file}`);
    return Boolean(f.image);
  })
  .slice(0, limit);
---

{items.length > 0 ? (
  <ul class="gallery">
    {items.map((f, i) => (
      <li>
        <figure>
          <Image
            src={f.image!}
            alt={f.alt}
            width={720}
            height={540}
            widths={[360, 540, 720, 1080]}
            sizes="(max-width: 40rem) 90vw, (max-width: 64rem) 45vw, 22rem"
            fit="cover"
            format="webp"
            loading={i < 3 ? 'eager' : 'lazy'}
          />
          {(f.caption || f.when) && (
            <figcaption class="small muted">
              {f.caption}
              {f.when && <span> · {f.when}</span>}
            </figcaption>
          )}
        </figure>
      </li>
    ))}
  </ul>
) : (
  <p class="notice">As fotos chegam em breve.</p>
)}

<style>
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    max-width: 62rem;
  }
  .gallery figure {
    margin: 0;
  }
  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-paper);
  }
  .gallery figcaption {
    margin-top: var(--space-2);
  }
</style>
