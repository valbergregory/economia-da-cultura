---
/** Página de uma publicação (texto, crítica, poema, música ou destaque). */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import Icon from './Icon.astro';
import Share from './Share.astro';
import { site, type NavKey } from '@/data/site';
import { absolute, dateIso, formatDate, ORIGIN, url } from '@/lib/content';

interface Nav {
  href: string;
  title: string;
}
interface Props {
  title: string;
  summary: string;
  date: Date;
  updated?: Date;
  /** Caminho sem base, ex.: /textos/meu-texto/ */
  path: string;
  current: NavKey;
  kicker: string;
  kickerTone?: 'wine' | 'gold' | 'moss';
  /** Pares rótulo/valor mostrados sob o título (obra, autor, lugar…). */
  facts?: { label: string; value: string }[];
  cover?: ImageMetadata;
  coverAlt?: string;
  tags?: string[];
  minutes?: number;
  /** Poema: corpo com quebras de linha preservadas e sem resumo destacado. */
  poem?: boolean;
  /** Preserva quebras de linha simples nos parágrafos (letras de música). */
  lines?: boolean;
  linkedin?: string;
  external?: { href: string; label: string };
  prev?: Nav;
  next?: Nav;
  back: { href: string; label: string };
  schemaType?: 'Article' | 'Review' | 'CreativeWork' | 'MusicRecording' | 'Event';
  jsonLdExtra?: Record<string, unknown>;
}
const {
  title,
  summary,
  date,
  updated,
  path,
  current,
  kicker,
  kickerTone = 'wine',
  facts = [],
  cover,
  coverAlt,
  tags = [],
  minutes,
  poem = false,
  lines = false,
  linkedin,
  external,
  prev,
  next,
  back,
  schemaType = 'Article',
  jsonLdExtra = {},
} = Astro.props;

const og = cover
  ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;
const fullUrl = absolute(path);
---

<Base
  {title}
  description={summary}
  {current}
  {path}
  type="article"
  image={og?.src}
  imageAlt={coverAlt}
  publishedTime={dateIso(date)}
  modifiedTime={updated ? dateIso(updated) : undefined}
  jsonLd={[
    {
      '@type': schemaType,
      headline: title,
      name: title,
      description: summary,
      datePublished: dateIso(date),
      ...(updated ? { dateModified: dateIso(updated) } : {}),
      inLanguage: 'pt-BR',
      url: fullUrl,
      ...(og ? { image: `${ORIGIN}${og.src}` } : {}),
      author: { '@id': `${absolute('/')}#person` },
      keywords: tags.join(', '),
      isAccessibleForFree: true,
      ...jsonLdExtra,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: absolute('/') },
        { '@type': 'ListItem', position: 2, name: back.label, item: absolute(back.href) },
        { '@type': 'ListItem', position: 3, name: title, item: fullUrl },
      ],
    },
  ]}
>
  <header class="entry-head">
    <div class="container">
      <nav class="crumbs small" aria-label="Você está em">
        <a href={url('/')}>Início</a> <span aria-hidden="true">/</span>{' '}
        <a href={url(back.href)}>{back.label}</a>
      </nav>
      <p class="kicker">
        <span class:list={['tag', kickerTone]}>{kicker}</span>
      </p>
      <h1>{title}</h1>
      {facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )}
      <p class="meta">
        <span>
          Publicado em <time datetime={dateIso(date)}>{formatDate(date)}</time>
        </span>
        {updated && (
          <span>
            · Atualizado em <time datetime={dateIso(updated)}>{formatDate(updated)}</time>
          </span>
        )}
        <span>· {site.authorShort}</span>
        {minutes && (
          <span>
            · <Icon name="clock" size={14} /> {minutes} min de leitura
          </span>
        )}
      </p>
    </div>
  </header>

  <div class="container entry-layout">
    <article class="entry">
      {cover && (
        <figure class="cover">
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            width={960}
            height={600}
            widths={[480, 720, 960, 1400]}
            sizes="(max-width: 48rem) 92vw, 720px"
            fit="cover"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )}
      <slot name="media" />
      {!poem && <p class="lead summary">{summary}</p>}
      <div class:list={[poem ? 'poema' : 'markdown prose', { lines }]}>
        <slot />
      </div>
      <slot name="after" />

      {tags.length > 0 && (
        <ul class="tag-list tags" aria-label="Temas">
          {tags.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )}

      <footer class="entry-foot">
        {external && (
          <p>
            <a href={external.href} rel="noopener" target="_blank">
              {external.label} <Icon name="external" size={14} />
              <span class="visually-hidden">(abre em nova aba)</span>
            </a>
          </p>
        )}
        <p>
          <a href={linkedin ?? site.links.linkedin} rel="noopener" target="_blank">
            <Icon name="linkedin" size={16} /> Comentar no LinkedIn
            <span class="visually-hidden">(abre em nova aba)</span>
          </a>
        </p>
        <Share url={fullUrl} {title} />
        <aside class="author">
          <p class="author-name">{site.author}</p>
          <p class="small muted">{site.bio}</p>
          <p class="small">
            <a href={url('/sobre/')}>Sobre este site</a> ·{' '}
            <a href={site.links.academic}>Site acadêmico</a>
          </p>
        </aside>
      </footer>

      <nav class="entry-nav" aria-label={back.label}>
        {prev && (
          <a class="nav-link" href={prev.href} rel="prev">
            <span class="small muted">Anterior</span>
            <span>{prev.title}</span>
          </a>
        )}
        {next && (
          <a class="nav-link" href={next.href} rel="next">
            <span class="small muted">Seguinte</span>
            <span>{next.title}</span>
          </a>
        )}
        <p class="nav-actions">
          <a class="button subtle" href={url(back.href)}>
            {back.label}
          </a>
        </p>
      </nav>
    </article>
  </div>
</Base>

<style>
  .entry-head {
    padding-block: var(--space-6) var(--space-6);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(60rem 22rem at 100% -10%, var(--gold-soft) 0%, transparent 60%), var(--bg);
  }
  .crumbs {
    margin-bottom: var(--space-4);
    color: var(--text-muted);
  }
  .kicker {
    margin-bottom: var(--space-3);
  }
  .entry-head h1 {
    max-width: 24ch;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-3);
  }
  .facts div {
    display: flex;
    gap: 0.4rem;
    font-size: var(--text-sm);
  }
  .facts dt {
    color: var(--text-muted);
  }
  .facts dt::after {
    content: ':';
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .entry-layout {
    padding-block: var(--space-7);
  }
  .entry {
    max-width: 72ch;
    margin-inline: auto;
  }
  .cover {
    margin: 0 0 var(--space-6);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }
  .cover :global(img) {
    width: 100%;
    height: auto;
  }
  .summary {
    margin-bottom: var(--space-5);
  }
  .lines :global(p) {
    white-space: pre-line;
  }
  .tags {
    margin-top: var(--space-5);
  }
  .entry-foot {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    display: grid;
    gap: var(--space-4);
  }
  .entry-foot p {
    margin: 0;
  }
  .entry-foot p a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .author {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }
  .author-name {
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .entry-nav {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }
  .nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    background: var(--bg-elevated);
  }
  .nav-link:hover {
    border-color: var(--border-strong);
    color: var(--link-hover);
  }
  .nav-actions {
    margin: var(--space-2) 0 0;
    display: flex;
    gap: var(--space-3);
  }
  @media (max-width: 56rem) {
    .facts {
      justify-content: center;
    }
    .entry-head h1 {
      margin-inline: auto;
    }
  }
</style>
