---
/** Página de uma publicação (texto, crítica, música ou destaque), centralizada. */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import Share from './Share.astro';
import { site, type NavKey } from '@/data/site';
import { absolute, dateIso, formatDate, ORIGIN, url } from '@/lib/content';

interface Nav {
  href: string;
  title: string;
}
interface Props {
  title: string;
  summary: string;
  date: Date;
  updated?: Date;
  /** Caminho sem base, ex.: /textos/meu-texto/ */
  path: string;
  current: NavKey;
  kicker: string;
  /** Pares rótulo/valor mostrados sob o título (obra, autor, lugar…). */
  facts?: { label: string; value: string }[];
  cover?: ImageMetadata;
  coverAlt?: string;
  tags?: string[];
  minutes?: number;
  /** Preserva quebras de linha simples nos parágrafos (letras de música). */
  lines?: boolean;
  external?: { href: string; label: string };
  prev?: Nav;
  next?: Nav;
  /** Seção de origem na página inicial (âncora) e seu rótulo. */
  back: { href: string; label: string };
  schemaType?: 'Article' | 'Review' | 'CreativeWork' | 'MusicRecording' | 'Event';
  jsonLdExtra?: Record<string, unknown>;
}
const {
  title,
  summary,
  date,
  updated,
  path,
  current,
  kicker,
  facts = [],
  cover,
  coverAlt,
  tags = [],
  minutes,
  lines = false,
  external,
  prev,
  next,
  back,
  schemaType = 'Article',
  jsonLdExtra = {},
} = Astro.props;

const og = cover
  ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;
const fullUrl = absolute(path);
---

<Base
  {title}
  description={summary}
  {current}
  {path}
  type="article"
  image={og?.src}
  imageAlt={coverAlt}
  publishedTime={dateIso(date)}
  modifiedTime={updated ? dateIso(updated) : undefined}
  jsonLd={[
    {
      '@type': schemaType,
      headline: title,
      name: title,
      description: summary,
      datePublished: dateIso(date),
      ...(updated ? { dateModified: dateIso(updated) } : {}),
      inLanguage: 'pt-BR',
      url: fullUrl,
      ...(og ? { image: `${ORIGIN}${og.src}` } : {}),
      author: { '@id': `${absolute('/')}#person` },
      keywords: tags.join(', '),
      isAccessibleForFree: true,
      ...jsonLdExtra,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: absolute('/') },
        { '@type': 'ListItem', position: 2, name: back.label, item: absolute(back.href) },
        { '@type': 'ListItem', position: 3, name: title, item: fullUrl },
      ],
    },
  ]}
>
  <header class="entry-head container">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    )}
    <p class="meta">
      <span>
        <time datetime={dateIso(date)}>{formatDate(date)}</time>
      </span>
      {updated && (
        <span>
          · atualizado em <time datetime={dateIso(updated)}>{formatDate(updated)}</time>
        </span>
      )}
      <span>· {site.authorShort}</span>
      {minutes && <span>· {minutes} min de leitura</span>}
    </p>
    <hr class="rule short" />
  </header>

  <article class="entry container">
    {cover && (
      <figure class="cover">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          width={1100}
          height={620}
          widths={[560, 820, 1100, 1600]}
          sizes="(max-width: 64rem) 92vw, 60rem"
          fit="cover"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}
    <slot name="media" />
    <p class="lead summary">{summary}</p>
    <div class:list={['markdown', { lines }]}>
      <slot />
    </div>

    {tags.length > 0 && (
      <ul class="chip-list tags" aria-label="Temas">
        {tags.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )}

    <footer class="entry-foot">
      {external && (
        <p>
          <a href={external.href} rel="noopener" target="_blank">
            {external.label} <span class="visually-hidden">(abre em nova aba)</span>
          </a>
        </p>
      )}
      <Share url={fullUrl} {title} />
      <p class="small muted opinion">{site.legal.opinion}</p>
      <p class="small muted">
        © {site.author}. {site.legal.rights}
      </p>
    </footer>

    <nav class="entry-nav" aria-label={back.label}>
      {prev && (
        <a class="nav-link" href={prev.href} rel="prev">
          <span class="small muted">Anterior</span>
          <span>{prev.title}</span>
        </a>
      )}
      {next && (
        <a class="nav-link" href={next.href} rel="next">
          <span class="small muted">Seguinte</span>
          <span>{next.title}</span>
        </a>
      )}
      <p class="nav-actions">
        <a class="button secondary" href={url(back.href)}>
          {back.label}
        </a>
        <a class="button subtle" href={url('/')}>
          Início
        </a>
      </p>
    </nav>
  </article>
</Base>

<style>
  .entry-head {
    padding-block: var(--space-7) var(--space-5);
  }
  .entry-head h1 {
    max-width: 30ch;
    margin-bottom: var(--space-4);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-3);
  }
  .facts div {
    display: flex;
    gap: 0.4rem;
    font-size: var(--text-sm);
  }
  .facts dt {
    color: var(--text-muted);
  }
  .facts dt::after {
    content: ':';
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .rule.short {
    width: 6rem;
    margin: var(--space-5) auto 0;
  }
  .entry {
    padding-bottom: var(--space-7);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cover {
    margin: 0 0 var(--space-6);
    width: min(100%, 60rem);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-paper);
  }
  .cover :global(img) {
    width: 100%;
    height: auto;
  }
  .summary {
    margin-bottom: var(--space-6);
    font-family: var(--font-display);
    font-style: italic;
  }
  .tags {
    margin-top: var(--space-6);
  }
  .entry-foot {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-strong);
    width: min(100%, var(--measure));
    display: grid;
    gap: var(--space-4);
    justify-items: center;
  }
  .entry-foot p {
    margin: 0;
  }
  .opinion {
    font-style: italic;
  }
  .entry-nav {
    margin-top: var(--space-6);
    width: min(100%, var(--measure));
    display: grid;
    gap: var(--space-3);
  }
  .nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
  }
  .nav-link:hover {
    border-color: var(--rule-strong);
    color: var(--terracotta-deep);
  }
  .nav-actions {
    margin: var(--space-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
