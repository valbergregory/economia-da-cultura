---
/** Cartão genérico de uma publicação (texto, crítica, poema, música ou destaque). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { dateIso, formatDate } from '@/lib/content';

interface Props {
  href: string;
  title: string;
  date: Date;
  summary?: string;
  /** Rótulo pequeno acima do título (eixo, tipo, alcance…). */
  kicker?: string;
  kickerTone?: 'wine' | 'gold' | 'moss';
  /** Linha extra abaixo do título (obra, autor, lugar…). */
  detail?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  minutes?: number;
  tags?: string[];
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
  /** Trecho de poema exibido em vez do resumo. */
  excerpt?: string;
}
const {
  href,
  title,
  date,
  summary,
  kicker,
  kickerTone = 'wine',
  detail,
  cover,
  coverAlt,
  minutes,
  tags = [],
  eager = false,
  headingLevel = 'h3',
  excerpt,
} = Astro.props;
const Heading = headingLevel;
---

<article class="card entry-card">
  {cover && (
    <a class="cover" href={href} tabindex="-1" aria-hidden="true">
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        width={720}
        height={450}
        widths={[360, 540, 720]}
        sizes="(max-width: 40rem) 90vw, 360px"
        fit="cover"
        format="webp"
        loading={eager ? 'eager' : 'lazy'}
      />
    </a>
  )}
  <div class="body">
    <p class="meta">
      {kicker && <span class:list={['tag', kickerTone]}>{kicker}</span>}
      <time datetime={dateIso(date)}>{formatDate(date, { month: 'short' })}</time>
      {minutes && (
        <span>
          <Icon name="clock" size={13} /> {minutes} min
        </span>
      )}
    </p>
    <Heading>
      <a href={href}>{title}</a>
    </Heading>
    {detail && <p class="detail muted">{detail}</p>}
    {excerpt ? <p class="excerpt">{excerpt}</p> : summary && <p class="summary">{summary}</p>}
    {tags.length > 0 && (
      <ul class="chip-list" aria-label="Temas">
        {tags.slice(0, 4).map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )}
    <p class="card-actions">
      <a class="button secondary" href={href}>
        Ler <Icon name="arrow" size={16} />
      </a>
    </p>
  </div>
</article>

<style>
  .entry-card {
    padding: 0;
    overflow: hidden;
  }
  .cover {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--bg-muted);
    border-bottom: 1px solid var(--border);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .entry-card h2,
  .entry-card h3 {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }
  .detail,
  .summary,
  .excerpt {
    margin: 0;
    font-size: var(--text-sm);
  }
  .excerpt {
    font-family: var(--font-display);
    font-size: var(--text-md);
    white-space: pre-line;
    line-height: 1.6;
  }
  .card-actions {
    margin: var(--space-2) 0 0;
  }
  .card-actions .button {
    min-height: 2.5rem;
    padding-block: 0.4rem;
  }
</style>
