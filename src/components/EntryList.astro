---
/**
 * Lista em linhas, como no modelo: data | CATEGORIA | Título — com filetes.
 * Centralizada; no celular cada linha vira um bloco.
 */
import { dateIso, formatDate } from '@/lib/content';

export interface Row {
  href: string;
  title: string;
  date: Date;
  label: string;
  /** Linha secundária opcional (obra, lugar…). */
  detail?: string;
}
interface Props {
  rows: Row[];
  empty?: string;
  ariaLabel?: string;
}
const { rows, empty = 'Em breve.', ariaLabel } = Astro.props;
---

{rows.length === 0 ? (
  <p class="notice">{empty}</p>
) : (
  <ol class="rows" aria-label={ariaLabel}>
    {rows.map((r) => (
      <li class="row">
        <time class="date" datetime={dateIso(r.date)}>
          {formatDate(r.date, { month: 'short' })
            .replace(/\.? de /g, ' ')
            .replace(/\.$/, '')}
        </time>
        <span class="sep" aria-hidden="true"></span>
        <span class="tag">{r.label}</span>
        <span class="title">
          <a href={r.href}>{r.title}</a>
          {r.detail && <span class="detail"> — {r.detail}</span>}
        </span>
      </li>
    ))}
  </ol>
)}

<style>
  .rows {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 58rem;
    border-top: 1px solid var(--rule-strong);
  }
  .row {
    display: grid;
    grid-template-columns: 7.5rem 1px 7.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0 var(--space-5);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
  }
  .date {
    font-size: var(--text-sm);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .sep {
    width: 1px;
    height: 1.2rem;
    background: var(--rule-strong);
    align-self: center;
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--ink);
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a:hover {
    color: var(--terracotta-deep);
    text-decoration: underline;
  }
  .detail {
    font-style: italic;
    color: var(--text-muted);
    font-size: var(--text-base);
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
      text-align: center;
      padding-block: var(--space-4);
    }
    .sep {
      display: none;
    }
  }
</style>
