---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import EntryList, { type Row } from '@/components/EntryList.astro';
import Gallery from '@/components/Gallery.astro';
import { AXIS_LABELS, KIND_LABELS, SCOPE_LABELS, site } from '@/data/site';
import { entryPath, published, url } from '@/lib/content';
import baixo from '@/assets/fotos/valber-baixo.webp';
import banner from '@/assets/banner-economia-cultura.webp';

const textos = await published('textos');
const criticas = await published('criticas');
const musicas = await published('musicas');
const destaques = await published('destaques');

const abertura = textos.find((t) => t.data.featured);
const outros = textos.filter((t) => t.id !== abertura?.id);

const rowsTextos: Row[] = outros.slice(0, 8).map((t) => ({
  href: entryPath('textos', t),
  title: t.data.title,
  date: t.data.date,
  label: AXIS_LABELS[t.data.axis] ?? t.data.axis,
  detail: t.data.scope ? SCOPE_LABELS[t.data.scope] : undefined,
}));
const rowsCriticas: Row[] = criticas.map((c) => ({
  href: entryPath('criticas', c),
  title: c.data.title,
  date: c.data.date,
  label: KIND_LABELS[c.data.kind] ?? c.data.kind,
  detail: [c.data.work, c.data.creator].filter(Boolean).join(', '),
}));
const rowsMusicas: Row[] = musicas.map((m) => ({
  href: entryPath('musicas', m),
  title: m.data.title,
  date: m.data.date,
  label: m.data.year ? String(m.data.year) : 'Música',
  detail: m.data.credits,
}));
const rowsDestaques: Row[] = destaques.map((d) => ({
  href: entryPath('destaques', d),
  title: d.data.title,
  date: d.data.date,
  label: SCOPE_LABELS[d.data.scope] ?? d.data.scope,
  detail: [d.data.place, d.data.when].filter(Boolean).join(' · '),
}));
const arquivo: Row[] = [
  ...textos.map((t) => ({
    href: entryPath('textos', t),
    title: t.data.title,
    date: t.data.date,
    label: 'Texto',
  })),
  ...criticas.map((c) => ({
    href: entryPath('criticas', c),
    title: c.data.title,
    date: c.data.date,
    label: 'Crítica',
  })),
  ...musicas.map((m) => ({
    href: entryPath('musicas', m),
    title: m.data.title,
    date: m.data.date,
    label: 'Música',
  })),
  ...destaques.map((d) => ({
    href: entryPath('destaques', d),
    title: d.data.title,
    date: d.data.date,
    label: 'Destaque',
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const temas = [
  { label: 'Textos semanais', href: '#textos' },
  { label: 'Livros', href: '#critica' },
  { label: 'Filmes e séries', href: '#critica' },
  { label: 'Quadrinhos', href: '#critica' },
  { label: 'Música', href: '#musica' },
  { label: 'Festivais, editais e políticas culturais', href: '#destaques' },
  { label: 'Arquivo', href: '#arquivo' },
];
---

<Base title={site.longName} description={site.description} current="home" path="/">
  <div class="container masthead">
    <Image
      src={banner}
      alt="Ilustração em aquarela com o título Economia & Cultura, por Valber Gregory: livros, notas musicais, uma cidade histórica ao fundo, uma película de cinema, um busto clássico e um gráfico de linha."
      width={1942}
      height={809}
      widths={[720, 1080, 1440, 1942]}
      sizes="(max-width: 72rem) 100vw, 70rem"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <section class="hero container">
    <p class="kicker">Cultura, história, entretenimento e economia</p>
    {abertura ? (
      <>
        <h1>{abertura.data.title}</h1>
        <p class="lead">{abertura.data.summary}</p>
        <p class="actions">
          <a class="button" href={entryPath('textos', abertura)}>
            Ler o texto de abertura
          </a>
        </p>
      </>
    ) : (
      <>
        <h1>Por que olhar a cultura pela economia?</h1>
        <p class="lead">{site.tagline}</p>
      </>
    )}
    <figure class="hero-photo">
      <Image
        src={baixo}
        alt="Valber tocando um baixo elétrico de cinco cordas, de pé, diante de um microfone."
        width={880}
        height={880}
        widths={[480, 720, 880, 1080]}
        sizes="(max-width: 56rem) 88vw, 34rem"
        format="webp"
        loading="eager"
      />
      <figcaption class="small muted">
        Valber Gregory, em ensaio. Foto do acervo pessoal.
      </figcaption>
    </figure>
  </section>

  <section class="section" id="textos" aria-labelledby="textos-title">
    <div class="container">
      <h2 id="textos-title" class="section-title">
        Textos recentes
      </h2>
      <EntryList
        rows={rowsTextos}
        ariaLabel="Textos recentes"
        empty="O texto de abertura já está no ar; os próximos textos semanais aparecem aqui."
      />
      {outros.length > 8 && (
        <p class="more">
          <a class="arrow-link" href="#arquivo">
            Ver todos os textos <span aria-hidden="true">→</span>
          </a>
        </p>
      )}
      <div class="panel">
        <h3 class="section-title">Neste espaço</h3>
        <p class="small muted">
          Escrevo sobre cultura e entretenimento a partir de algumas frentes. Você pode explorar os
          temas abaixo:
        </p>
        <ul class="temas">
          {temas.map((t) => (
            <li>
              <a href={t.href}>{t.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="critica" aria-labelledby="critica-title">
    <div class="container">
      <h2 id="critica-title" class="section-title">
        Crítica
      </h2>
      <p class="lead">
        Livros, filmes, séries, quadrinhos, discos, espetáculos e exposições — com o olhar da
        economia e da história quando cabe, e sem ele quando não cabe.
      </p>
      <EntryList
        rows={rowsCriticas}
        ariaLabel="Crítica"
        empty="As primeiras críticas chegam em breve."
      />
    </div>
  </section>

  <section class="section" id="musica" aria-labelledby="musica-title">
    <div class="container">
      <h2 id="musica-title" class="section-title">
        Música
      </h2>
      <p class="lead">
        As músicas que gravo, com letra e ficha técnica, e as fotos de palco e bastidores.
      </p>
      <EntryList
        rows={rowsMusicas}
        ariaLabel="Músicas"
        empty="As primeiras gravações chegam em breve."
      />
      <h3 class="section-title fotos-title">Fotos</h3>
      <Gallery />
    </div>
  </section>

  <section class="section" id="destaques" aria-labelledby="destaques-title">
    <div class="container">
      <h2 id="destaques-title" class="section-title">
        Destaques culturais
      </h2>
      <p class="lead">
        Situações e eventos culturais que merecem atenção — de Penedo e Alagoas ao mundo —, com o
        que está em jogo do ponto de vista econômico e jurídico.
      </p>
      <EntryList
        rows={rowsDestaques}
        ariaLabel="Destaques culturais"
        empty="Os primeiros destaques chegam em breve."
      />
    </div>
  </section>

  <section class="section" id="arquivo" aria-labelledby="arquivo-title">
    <div class="container">
      <h2 id="arquivo-title" class="section-title">
        Arquivo
      </h2>
      <p class="lead">Tudo o que já foi publicado, do mais recente ao mais antigo.</p>
      <EntryList rows={arquivo} ariaLabel="Arquivo" empty="Nada publicado ainda." />
      <p class="more small">
        <a href={url('/rss.xml')}>Assinar via RSS</a> · <a href={url('/sobre/')}>Sobre este site</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .masthead {
    padding-top: var(--space-5);
  }
  .masthead :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .hero {
    padding-block: var(--space-7) var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero h1 {
    margin-bottom: var(--space-4);
  }
  .hero .lead {
    font-size: var(--text-lg);
  }
  .actions {
    margin: var(--space-3) 0 var(--space-7);
  }
  .hero-photo {
    margin: 0;
    width: min(100%, 34rem);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-paper);
  }
  .hero-photo figcaption {
    margin-top: var(--space-2);
  }
  .more {
    margin: var(--space-5) 0 0;
  }
  .panel {
    margin-top: var(--space-7);
  }
  .temas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
  }
  .temas a {
    font-size: var(--text-md);
  }
  .fotos-title {
    margin-top: var(--space-7);
  }
</style>
