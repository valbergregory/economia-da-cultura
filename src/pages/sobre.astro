---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { url } from '@/lib/content';

const page = await getEntry('paginas', 'sobre');
if (!page) throw new Error('src/content/paginas/sobre.md não encontrado');
const { Content } = await render(page);
const d = page.data;
---

<Base title="Sobre" description={d.summary} current="sobre" path="/sobre/" type="profile">
  <header class="head container">
    <p class="kicker">Sobre · apresentação</p>
    <h1>{d.title}</h1>
    <p class="lead">{d.summary}</p>
    <hr class="rule short" />
  </header>

  <article class="container body">
    {d.cover && (
      <figure class="cover">
        <Image
          src={d.cover}
          alt={d.coverAlt ?? ''}
          width={1100}
          height={425}
          widths={[560, 820, 1100, 1800]}
          sizes="(max-width: 64rem) 92vw, 60rem"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}
    <div class="markdown">
      <Content />
    </div>

    <section class="markdown extra" aria-labelledby="funciona">
      <h2 id="funciona">Como o site funciona</h2>
      <p>
        Tudo fica em uma única página: os <a href={url('/#textos')}>textos</a> semanais, a
        <a href={url('/#critica')}>crítica</a> de livros, filmes, séries, quadrinhos, discos,
        espetáculos e exposições, a <a href={url('/#musica')}>música</a> (gravações com letra e
        ficha técnica, e fotos) e os <a href={url('/#destaques')}>destaques culturais</a> em nível
        local, regional, nacional e internacional. O <a href={url('/#arquivo')}>arquivo</a> reúne
        tudo em ordem cronológica, e cada publicação tem o próprio endereço para compartilhar. Tudo
        pode ser acompanhado por <a href={url('/rss.xml')}>RSS</a>. O site não usa cookies nem
        rastreamento; vídeos e players externos só carregam quando você pede.
      </p>
      <h2>Contato</h2>
      <p>
        <a href={`mailto:${site.email}`}>
          <Icon name="mail" size={16} /> {site.email}
        </a>
      </p>
      <h2>Opinião, direitos e uso</h2>
      <p>{site.legal.opinion}</p>
      <p>{site.legal.rights}</p>
      <p>{site.legal.image}</p>
    </section>
  </article>
</Base>

<style>
  .head {
    padding-block: var(--space-7) var(--space-5);
  }
  .head h1 {
    max-width: 30ch;
  }
  .rule.short {
    width: 6rem;
    margin: var(--space-5) auto 0;
  }
  .body {
    padding-block: var(--space-6) var(--space-7);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cover {
    margin: 0 0 var(--space-6);
    width: min(100%, 60rem);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-paper);
  }
  .cover :global(img) {
    width: 100%;
    height: auto;
  }
  .extra {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-strong);
    width: min(100%, var(--measure));
  }
  .extra p a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
