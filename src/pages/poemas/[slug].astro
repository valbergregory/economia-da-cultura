---
import { render } from 'astro:content';
import EntryPage from '@/components/EntryPage.astro';
import { entryPath, published, slugOf } from '@/lib/content';

export async function getStaticPaths() {
  const all = await published('poemas');
  return all.map((entry, i) => ({
    params: { slug: slugOf(entry) },
    props: { entry, newer: all[i - 1], older: all[i + 1] },
  }));
}
const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const summary =
  d.summary ??
  `Poema de Valber Gregory: ${(entry.body ?? '')
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean)
    .slice(0, 2)
    .join(' / ')}`;
const facts = [
  ...(d.written ? [{ label: 'Escrito em', value: d.written }] : []),
  ...(d.dedication ? [{ label: 'Para', value: d.dedication }] : []),
];
---

<EntryPage
  title={d.title}
  {summary}
  date={d.date}
  updated={d.updated}
  path={`/poemas/${slugOf(entry)}/`}
  current="poemas"
  kicker="Poema"
  kickerTone="moss"
  {facts}
  cover={d.cover}
  coverAlt={d.coverAlt}
  tags={d.tags}
  poem
  prev={older ? { href: entryPath('poemas', older), title: older.data.title } : undefined}
  next={newer ? { href: entryPath('poemas', newer), title: newer.data.title } : undefined}
  back={{ href: '/poemas/', label: 'Poemas' }}
  schemaType="CreativeWork"
  jsonLdExtra={{ genre: 'Poesia' }}
>
  <Content />
</EntryPage>
