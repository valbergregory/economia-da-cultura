---
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import EntryCard from '@/components/EntryCard.astro';
import { entryPath, published } from '@/lib/content';

const poemas = await published('poemas');
const description = 'Poemas de Valber Gregory, publicados aos poucos.';
const excerpt = (body: string | undefined) =>
  (body ?? '')
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean)
    .slice(0, 4)
    .join('\n');
---

<Base title="Poemas" {description} current="poemas" path="/poemas/">
  <PageHead title="Poemas" eyebrow="Versos" lead="Poemas próprios, publicados aos poucos." />
  <div class="container list">
    {poemas.length === 0 ? (
      <p class="notice">Os primeiros poemas chegam em breve.</p>
    ) : (
      <div class="grid grid-3">
        {poemas.map((p) => (
          <EntryCard
            headingLevel="h2"
            href={entryPath('poemas', p)}
            title={p.data.title}
            date={p.data.date}
            kicker="Poema"
            kickerTone="moss"
            detail={p.data.written ? `Escrito em ${p.data.written}` : undefined}
            excerpt={excerpt(p.body)}
            cover={p.data.cover}
            coverAlt={p.data.coverAlt}
            tags={p.data.tags}
          />
        ))}
      </div>
    )}
  </div>
</Base>

<style>
  .list {
    padding-block: var(--space-7);
  }
</style>
