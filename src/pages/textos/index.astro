---
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import EntryCard from '@/components/EntryCard.astro';
import Icon from '@/components/Icon.astro';
import { AXIS_LABELS, SCOPE_LABELS } from '@/data/site';
import { entryPath, published, readingTime, url } from '@/lib/content';

const textos = await published('textos');
const description =
  'Textos semanais de Valber Gregory: críticas econômicas e jurídicas sobre situações culturais — locais, regionais, nacionais e internacionais.';
---

<Base title="Textos" {description} current="textos" path="/textos/">
  <PageHead
    title="Textos"
    eyebrow="Um texto novo por semana"
    lead="Críticas econômicas e jurídicas sobre situações culturais, em nível local, regional, nacional e internacional — além de opiniões e crônicas."
  >
    <p class="small rss">
      <a href={url('/rss.xml')}>
        <Icon name="rss" size={14} /> Assinar via RSS
      </a>
    </p>
  </PageHead>
  <div class="container list">
    {textos.length === 0 ? (
      <p class="notice">O primeiro texto está a caminho. Volte em breve — ou assine o RSS.</p>
    ) : (
      <div class="grid grid-3">
        {textos.map((t, i) => (
          <EntryCard
            headingLevel="h2"
            href={entryPath('textos', t)}
            title={t.data.title}
            date={t.data.date}
            summary={t.data.summary}
            kicker={AXIS_LABELS[t.data.axis]}
            detail={t.data.scope ? SCOPE_LABELS[t.data.scope] : undefined}
            cover={t.data.cover}
            coverAlt={t.data.coverAlt}
            minutes={readingTime(t.body)}
            tags={t.data.tags}
            eager={i < 3}
          />
        ))}
      </div>
    )}
  </div>
</Base>

<style>
  .list {
    padding-block: var(--space-7);
  }
  .rss a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
