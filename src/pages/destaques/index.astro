---
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import EntryCard from '@/components/EntryCard.astro';
import { SCOPE_LABELS } from '@/data/site';
import { SCOPES } from '@/content.config';
import { entryPath, published } from '@/lib/content';

const destaques = await published('destaques');
const groups = SCOPES.map((s) => ({
  scope: s,
  label: SCOPE_LABELS[s]!,
  items: destaques.filter((d) => d.data.scope === s),
})).filter((g) => g.items.length > 0);
const description =
  'Destaques culturais escolhidos por Valber Gregory: situações e eventos em nível local, regional, nacional e internacional.';
---

<Base title="Destaques culturais" {description} current="destaques" path="/destaques/">
  <PageHead
    title="Destaques culturais"
    eyebrow="Local, regional, nacional e internacional"
    lead="Situações e eventos culturais que merecem atenção — de Penedo e Alagoas ao mundo —, com o que está em jogo do ponto de vista econômico e jurídico."
  >
    {groups.length > 1 && (
      <nav class="scopes" aria-label="Ir para o alcance">
        {groups.map((g) => (
          <a class="tag" href={`#${g.scope}`}>
            {g.label}
          </a>
        ))}
      </nav>
    )}
  </PageHead>
  <div class="container list">
    {groups.length === 0 ? (
      <p class="notice">Os primeiros destaques chegam em breve.</p>
    ) : (
      groups.map((g) => (
        <section class="scope" aria-labelledby={`${g.scope}-title`}>
          <div class="section-head">
            <h2 id={`${g.scope}-title`}>{g.label}</h2>
          </div>
          <div class="grid grid-3">
            {g.items.map((d) => (
              <EntryCard
                href={entryPath('destaques', d)}
                title={d.data.title}
                date={d.data.date}
                summary={d.data.summary}
                kicker={g.label}
                kickerTone="moss"
                detail={[d.data.place, d.data.when].filter(Boolean).join(' · ')}
                cover={d.data.cover}
                coverAlt={d.data.coverAlt}
                tags={d.data.tags}
              />
            ))}
          </div>
        </section>
      ))
    )}
  </div>
</Base>

<style>
  .list {
    padding-block: var(--space-7);
    display: grid;
    gap: var(--space-8);
  }
  .scope {
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  .scopes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .scopes .tag {
    min-height: 2.25rem;
    padding-inline: 0.8em;
  }
  @media (max-width: 56rem) {
    .scopes {
      justify-content: center;
    }
  }
</style>
