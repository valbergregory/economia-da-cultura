---
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import EntryCard from '@/components/EntryCard.astro';
import { KIND_LABELS } from '@/data/site';
import { CRITICA_KINDS } from '@/content.config';
import { entryPath, published, readingTime } from '@/lib/content';

const criticas = await published('criticas');
const kindsUsed = CRITICA_KINDS.filter((k) => criticas.some((c) => c.data.kind === k));
const description =
  'Críticas de livros, filmes, séries, discos, espetáculos e exposições, por Valber Gregory.';
---

<Base title="Crítica" {description} current="critica" path="/critica/">
  <PageHead
    title="Crítica"
    eyebrow="Livros, cinema e mais"
    lead="Leituras críticas de livros, filmes, séries, discos, espetáculos e exposições — com o olhar da economia e do direito quando cabe, e sem ele quando não cabe."
  >
    {kindsUsed.length > 1 && (
      <nav class="kinds" aria-label="Filtrar por tipo" data-kinds>
        <a href="?" class="tag active" data-kind="">
          Todos
        </a>
        {kindsUsed.map((k) => (
          <a href={`?tipo=${k}`} class="tag" data-kind={k}>
            {KIND_LABELS[k]}
          </a>
        ))}
      </nav>
    )}
  </PageHead>
  <div class="container list">
    {criticas.length === 0 ? (
      <p class="notice">As primeiras críticas chegam em breve.</p>
    ) : (
      <div class="grid grid-3" data-list>
        {criticas.map((c, i) => (
          <div data-kind={c.data.kind}>
            <EntryCard
              headingLevel="h2"
              href={entryPath('criticas', c)}
              title={c.data.title}
              date={c.data.date}
              summary={c.data.summary}
              kicker={KIND_LABELS[c.data.kind]}
              kickerTone="gold"
              detail={[c.data.work, c.data.creator, c.data.year].filter(Boolean).join(' · ')}
              cover={c.data.cover}
              coverAlt={c.data.coverAlt}
              minutes={readingTime(c.body)}
              tags={c.data.tags}
              eager={i < 3}
            />
          </div>
        ))}
      </div>
    )}
    <p class="notice" data-empty hidden>
      Nenhuma crítica desse tipo ainda.
    </p>
  </div>
</Base>

<style>
  .list {
    padding-block: var(--space-7);
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .kinds .tag {
    min-height: 2.25rem;
    padding-inline: 0.8em;
    cursor: pointer;
  }
  .kinds .tag.active {
    background: var(--wine);
    color: var(--text-inverse);
    border-color: var(--wine);
  }
  [data-list] > div {
    display: flex;
    min-width: 0;
  }
  [data-list] > div > :global(*) {
    flex: 1;
  }
  @media (max-width: 56rem) {
    .kinds {
      justify-content: center;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-kinds]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-list] > div'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  function apply(kind: string) {
    let shown = 0;
    for (const el of items) {
      const ok = !kind || el.dataset.kind === kind;
      el.hidden = !ok;
      if (ok) shown += 1;
    }
    if (empty) empty.hidden = shown > 0;
    nav?.querySelectorAll<HTMLElement>('[data-kind]').forEach((a) => {
      const on = (a.dataset.kind ?? '') === kind;
      a.classList.toggle('active', on);
      a.setAttribute('aria-current', on ? 'true' : 'false');
    });
  }
  if (nav) {
    apply(new URLSearchParams(location.search).get('tipo') ?? '');
    nav.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-kind]');
      if (!a) return;
      e.preventDefault();
      const kind = a.dataset.kind ?? '';
      apply(kind);
      history.replaceState(
        null,
        '',
        kind ? `${location.pathname}?tipo=${kind}` : location.pathname,
      );
    });
  }
</script>
